local spawn_interval = 1

function init(self)
	self.timer = spawn_interval
end

function update(self, dt)
	self.timer = self.timer - dt
	if self.timer <= 0 then
		self.timer = spawn_interval
		spawn_bubble()
	end
end

function spawn_bubble()
	local x = math.random(0, 1280)
	local y = -300
	local pos = vmath.vector3(x, y, 0)
	factory.create("#bubble_factory", pos, nil, {}, 1)
end
