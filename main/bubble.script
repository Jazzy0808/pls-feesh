local sprite = require("sprite")

local bubble_speed = 100
local popped_time = 1

function init(self)
	self.size = go.get_world_scale()
	self.popped = false
	self.timer = popped_time

	-- Optional: set initial image
	msg.post("#sprite", "play_animation", { id = hash("bubble") })
end

function update(self, dt)
	if not self.popped then
		local pos = go.get_position()
		pos.y = pos.y + bubble_speed * dt
		go.set_position(pos)
	else
		self.timer = self.timer - dt
		if self.timer <= 0 then
			go.delete()
		end
	end
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.pressed then
		local touch_pos = vmath.vector3(action.x, action.y, 0)
		local pos = go.get_position()
		local half_size = self.size * 50  -- tweak based on your sprite size

		if touch_pos.x >= pos.x - half_size.x and touch_pos.x <= pos.x + half_size.x and
		touch_pos.y >= pos.y - half_size.y and touch_pos.y <= pos.y + half_size.y then
			print("Bubble popped!")
			self.popped = true
			self.timer = popped_time

			-- Switch to the popped image
			msg.post("#sprite", "play_animation", { id = hash("popped") })
		end
	end
end
