-- bubble.lua
local bubble_speed = 100  -- Adjust the speed of the rising bubbles
local popped_time = 1     -- Time in seconds the popped bubble remains before disappearing

function init(self)
	self.size = go.get_world_scale()
	self.original_position = go.get_world_position()
	self.popped = false
	self.timer = popped_time
end

function update(self, dt)
	if not self.popped then
		-- Move the bubble upwards
		local pos = go.get_world_position()
		pos.y = pos.y + bubble_speed * dt
		go.set_position(pos)

		-- You can add logic here to make the bubble disappear when it reaches a certain height, if desired
	else
		-- Count down the timer after popping
		self.timer = self.timer - dt
		if self.timer <= 0 then
			go.delete()  -- Remove the bubble after it's been "popped" for 1 second
		end
	end
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.pressed then
		local touch_pos = vmath.vector3(action.x, action.y, 0)
		local pos = go.get_world_position()

		local half_size = self.size * 0.5

		-- Check if touch is within the bubble's bounds
		if touch_pos.x >= pos.x - half_size.x and touch_pos.x <= pos.x + half_size.x and
		touch_pos.y >= pos.y - half_size.y and touch_pos.y <= pos.y + half_size.y then
			print("Bubble touched!")
			self.popped = true

			-- Change to "popped" image (assuming you've already set up a popped texture in your sprite)
			msg.post(go.get_id(), "play_animation", {id = hash("popped")})

			-- Start the timer for popping
			self.timer = popped_time
		end
	end
end
