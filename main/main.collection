name: "main"
scale_along_z: 0
embedded_instances {
  id: "bubbles"
  data: "embedded_components {\n"
  "  id: \"background\"\n"
  "  type: \"sprite\"\n"
  "  data: \"default_animation: \\\"popScreen\\\"\\n"
  "material: \\\"/builtins/materials/sprite.material\\\"\\n"
  "textures {\\n"
  "  sampler: \\\"texture_sampler\\\"\\n"
  "  texture: \\\"/main/main.atlas\\\"\\n"
  "}\\n"
  "\"\n"
  "}\n"
  ""
  position {
    x: 640.0
    y: 360.0
  }
}
embedded_instances {
  id: "manager"
  data: "components {\n"
  "  id: \"bubble_manager\"\n"
  "  component: \"/main/bubble_manager.script\"\n"
  "}\n"
  "embedded_components {\n"
  "  id: \"bubble_factory\"\n"
  "  type: \"factory\"\n"
  "  data: \"prototype: \\\"/main/bubble.go\\\"\\n"
  "\"\n"
  "}\n"
  ""
}
embedded_instances {
  id: "Screens"
  data: "embedded_components {\n"
  "  id: \"sprite\"\n"
  "  type: \"sprite\"\n"
  "  data: \"default_animation: \\\"startScreenFull\\\"\\n"
  "material: \\\"/builtins/materials/sprite.material\\\"\\n"
  "textures {\\n"
  "  sampler: \\\"texture_sampler\\\"\\n"
  "  texture: \\\"/main/main.atlas\\\"\\n"
  "}\\n"
  "\"\n"
  "}\n"
  ""
  position {
    x: 640.0
    y: 360.0
    z: 10.0
  }
}
